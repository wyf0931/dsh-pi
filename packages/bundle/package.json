{
  "name": "dsh-pi",
  "version": "0.1.0-alpha.2",
  "description": "Installable DeepSeek Harness bundle for the Pi coding agent: registers the pi subagent provider, the delegate_pi tool, and a configuration page for the provider.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "pi",
    "coding-agent",
    "subagent"
  ],
  "license": "MIT",
  "author": "dsh-pi contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./subagent.d.ts",
      "default": "./subagent.js"
    },
    "./subagent": {
      "types": "./subagent.d.ts",
      "default": "./subagent.js"
    },
    "./tool": {
      "types": "./tool.d.ts",
      "default": "./tool.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./subagent/locale/*.json": "./subagent/locale/*.json",
    "./subagent/icon": "./subagent/icon.svg",
    "./tool/locale/*.json": "./tool/locale/*.json",
    "./tool/icon": "./tool/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "subagent.js",
    "subagent.d.ts",
    "tool.js",
    "tool.d.ts",
    "client.js",
    "locale",
    "icon.svg",
    "subagent",
    "tool",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "dsh-subagent-pi": "workspace:^",
    "dsh-tool-subagent-pi": "workspace:^"
  }
}
