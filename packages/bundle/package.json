{
  "name": "dsh-pi",
  "version": "0.1.0-alpha.1",
  "description": "Installable DeepSeek Harness bundle for the Pi coding agent: registers the pi subagent provider and the delegate_pi tool.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "pi",
    "coding-agent",
    "subagent"
  ],
  "license": "MIT",
  "author": "dsh-pi contributors",
  "type": "module",
  "exports": {
    "./subagent": {
      "types": "./subagent.d.ts",
      "default": "./subagent.js"
    },
    "./subagent/locale/*.json": "./subagent/locale/*.json",
    "./subagent/icon": "./subagent/icon.svg",
    "./tool": {
      "types": "./tool.d.ts",
      "default": "./tool.js"
    },
    "./tool/locale/*.json": "./tool/locale/*.json",
    "./tool/icon": "./tool/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "subagent.js",
    "subagent.d.ts",
    "tool.js",
    "tool.d.ts",
    "subagent",
    "tool",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-subagent-pi": "workspace:^",
    "dsh-tool-subagent-pi": "workspace:^"
  }
}
